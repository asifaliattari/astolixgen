<h3 id="augmentation-decision-table">Augmentation decision table</h3>
<table>
<thead>
<tr>
<th>Data property</th>
<th>Safe augmentations</th>
<th>Avoid</th>
<th>Why</th>
</tr>
</thead>
<tbody>
<tr>
<td>Natural photos, symmetric-ish classes</td>
<td>H-flip, crops, color jitter, ±15° rot</td>
<td>V-flip</td>
<td>Vertical flips unnatural for most scenes</td>
</tr>
<tr>
<td>Text / digits</td>
<td>Tiny shifts, mild blur</td>
<td>Any flip/rotation</td>
<td>Flips change the label ("3" vs "Ɛ")</td>
</tr>
<tr>
<td>Chest X-ray / asymmetric anatomy</td>
<td>Small crops, intensity jitter</td>
<td>H-flip, elastic</td>
<td>Heart position is diagnostic</td>
</tr>
<tr>
<td>Histopathology</td>
<td>H/V flip, 90° rotations, stain jitter</td>
<td>Heavy color jitter</td>
<td>Stain color carries signal</td>
</tr>
<tr>
<td>Satellite tiles</td>
<td>360° rotation, flips, scale jitter</td>
<td>Perspective warp</td>
<td>No canonical orientation; warp unphysical</td>
</tr>
<tr>
<td>Small objects / detection</td>
<td>Constrained crops (≥0.5 scale)</td>
<td>Aggressive RandomResizedCrop</td>
<td>Object can be cropped out entirely</td>
</tr>
<tr>
<td>Color-critical (ripeness, staining)</td>
<td>Geometric only</td>
<td>Hue jitter</td>
<td>Hue <em>is</em> the label signal</td>
</tr>
<tr>
<td>Rare classes, imbalanced</td>
<td>Oversample + mild aug</td>
<td>MixUp/CutMix (careful)</td>
<td>Blending drowns rare-class signal</td>
</tr>
</tbody>
</table>
